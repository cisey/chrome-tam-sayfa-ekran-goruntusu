{
  "manifest_version": 3,
  "name": "Tam Sayfa Ekran Görüntüsü",
  "version": "1.1.0",
  "description": "Web sayfalarının tamamını veya görünür alanını tek tıkla yüksek çözünürlüklü PNG/JPEG olarak yakalayın.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tam Sayfa Ekran Görüntüsü Al",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Ekran görüntüsü menüsünü aç"
    }
  }
}
